<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MauiAppQuiz.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
    BackgroundColor="#00371D"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <behaviors:StatusBarBehavior StatusBarColor="#3FBC55" StatusBarStyle="Default" />
    </ContentPage.Behaviors>

    <!--  Usando Grid para centralizar  -->
    <Grid>
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">

            <Image
                HeightRequest="140"
                HorizontalOptions="Center"
                Source="quiz.png" />

            <Label
                Margin="10"
                Padding="10"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                HorizontalTextAlignment="Center"
                Style="{StaticResource Headline}"
                Text="Teste seus conhecimentos!"
                TextColor="LightGreen" />

            <Button
                x:Name="BTNiniciar"
                BackgroundColor="LightGreen"
                CornerRadius="20"
                FontSize="12"
                HorizontalOptions="Center"
                Text="Iniciar o Quiz"
                TextColor="#00371D"
                WidthRequest="200"
                Clicked="BTNiniciar_Clicked"/>
        </VerticalStackLayout>
    </Grid>

</ContentPage>
