<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#00371D"
             x:Class="MauiAppQuiz.MainPage">

    <ContentPage.Behaviors>
        <!--<behaviors:StatusBarBehavior StatusBarColor="#3FBC55" StatusBarStyle="Default" />-->
        <behaviors:StatusBarBehavior StatusBarColor="Black" StatusBarStyle="Default" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout
            Padding="40,0"
            Spacing="30">
            <Image
                Source="quiz.png"
                HorizontalOptions="Center"
                HeightRequest="150"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a race car number eight" />

            <Label
                Text="Teste seus conhecimentos!"
                HorizontalOptions="Center"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Style="{StaticResource Headline}" />

            <Button
                x:Name="CounterBtn"
                Text="Click me"
                BackgroundColor="Black"
                Clicked="OnCounterClicked"
                HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
